# Deliberate binary breaks in 0.2.0, accepted against the 0.1.0 baseline.
# Every ApiError case gained a trailing `requestId: Option[String] = None`, which replaces the old constructor, apply
# and copy. Source that constructs these cases still compiles; bytecode compiled against 0.1.0 does not link.
# Delete this file when the baseline in build.sbt moves past 0.1.0.
ProblemFilters.exclude[DirectMissingMethodProblem]("io.github.ticofab.jev.JevError#ApiError.this(Int,java.lang.String,java.lang.String)Unit")
